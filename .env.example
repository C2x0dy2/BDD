# Copy this file to .env at the repo root before running docker compose.
# These are demo values for a student project, not production secrets.

# Django (api service)
DJANGO_SECRET_KEY=change-me-for-a-real-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Email: console backend by default (emails are printed to the api
# container logs, no real mailbox needed to run or grade this project).
# Uncomment and fill these in to send real emails via SMTP instead:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-address@gmail.com

# PostgreSQL bootstrap/owner role and restricted app role (commerce_app)
# are configured directly in docker/docker-compose.yml and created by
# api/e_commerce/management/commands/setup_relational_extras.py (kept in
# sync there on purpose). Nothing to set here for Postgres/Mongo
# connection details -- this file only carries Django-specific settings.

# Copy this file to .env at the repo root before running docker compose.
# These are demo values for a student project, not production secrets.

# Django (api service)
DJANGO_SECRET_KEY=change-me-for-a-real-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL bootstrap superuser and restricted app role are configured
# directly in docker/docker-compose.yml and docker/init-sql/01_schema.sql
# (kept in sync there on purpose, so the schema and the role grants always
# match). Nothing to set here for Postgres/Mongo connection details --
# this file only carries Django-specific settings.

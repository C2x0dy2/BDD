# Copy this file to .env at the repo root before running docker compose.
# These are demo values for a student project, not production secrets.

# Django (api service)
DJANGO_SECRET_KEY=change-me-for-a-real-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Email: console backend by default (emails are printed to the api
# container logs, no real mailbox needed to run or grade this project).
# Uncomment and fill these in to send real emails via SMTP instead:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-address@gmail.com

# PostgreSQL. POSTGRES_USER is the bootstrap/owner role (migrate + DDL only).
# The application itself connects as the restricted POSTGRES_APP_USER role,
# which setup_relational_extras creates with POSTGRES_APP_PASSWORD.
# Demo values -- change them for anything beyond a local demo.
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=sika
POSTGRES_APP_USER=commerce_app
POSTGRES_APP_PASSWORD=change-me-app

# MongoDB (authentication enabled). The same credentials appear in the two
# URLs below: keep them in sync.
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo
MONGO_URI=mongodb://mongo_admin:change-me-mongo@mongo:27017/?authSource=admin
ME_CONFIG_MONGODB_URL=mongodb://mongo_admin:change-me-mongo@mongo:27017/?authSource=admin
